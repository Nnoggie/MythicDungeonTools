{
  "runtime.version": "Lua 5.1",
  "workspace.ignoreDir": [
    ".github",
    ".vscode",
    ".luals",
    "**/Libs",
    "**/libs",
    "scripts"
  ],
  "diagnostics.globals": [
    "ReloadUI",
    "UISpecialFrames",
    "SlashCmdList",
    "ChatEdit_ActivateChat",
    "ChatEdit_OnEnterPressed",
    "ChatEdit_ChooseBoxForSend",
    "DEFAULT_CHAT_FRAME",
    "SettingsPanel",
    "coroutine",
    "Mixin",
    "BackdropTemplateMixin",
    "string",
    "math",
    "table",
    "UIParent",
    "C_AddOns",
    "UIFrameFadeOut",
    "GetLocale",
    "GetCurrentRegion",
    "C_Map",
    "CopyTable",
    "C_Timer",
    "date",
    "tinsert",
    "InCombatLockdown",
    "hooksecurefunc",
    "IsControlKeyDown",
    "GetTime",
    "UnitFullName",
    "format",
    "GetBuildInfo",
    "debugstack",
    "strsplit",
    "wipe",
    "tremove",
    "strsub",
    "GameFontNormal",
    "strtrim",
    "GameFontNormalLarge",
    "UnitName",
    "GetRealmName",
    "bit",
    "LibStub",
    "GAME_LOCALE",
    "DevTool",
    "MenuUtil",
    "GameTooltip_SetTitle",
    "WrapTextInColor",
    "ICON_LIST",
    "DrawLine",
    "errorhandler",
    "ChatFrame_AddMessageEventFilter",
    "UIFrameFlash",
    "MDTMapPanelFrame",
    "MDTScrollFrame",
    "CreateTexturePool",
    "CloseDropDownMenus",
    "GetAddOnMetadata",
    "LOCALIZED_CLASS_NAMES_MALE",
    "C_Secrets",
    "ChatFrameUtil",
    "TooltipDataProcessor",
    "StaticPopupDialogs",
    "OKAY",
    "StaticPopup_Show"
  ],
  "diagnostics.disable": [
    "invisible"
  ],
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.builtin": {
    "basic": "disable",
    "debug": "disable",
    "io": "disable",
    "math": "disable",
    "os": "disable",
    "package": "disable",
    "string": "disable",
    "table": "disable",
    "utf8": "disable"
  },
  "type.weakUnionCheck": false,
  "workspace.checkThirdParty": "Disable",
  "workspace.library": [
    ".luals/wow-api-0.22.3/extension/Annotations/Core"
  ],
  "diagnostics.ignoredFiles": "Disable",
  "diagnostics.libraryFiles": "Disable",
  "diagnostics.neededFileStatus": {
    "cast-local-type": "Any!"
  },
  "diagnostics.severity": {
    "cast-local-type": "Warning!",
    "unused-local": "Warning!",
    "unused-function": "Warning!",
    "unused-vararg": "Warning!",
    "redefined-local": "Warning!",
    "empty-block": "Warning!"
  }
}
